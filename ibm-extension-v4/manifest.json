{
  "manifest_version": 3,
  "name": "DOM Patch Assistant",
  "description": "Prompt an AI service to manipulate the current page DOM and cache the result.",
  "version": "0.1.0",
  "action": {
    "default_title": "DOM Patch Assistant",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z"
      },
      "description": "Open the DOM Patch Assistant popup"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "tabs", "notifications", "offscreen"],
  "host_permissions": ["<all_urls>", "http://localhost:8000/*", "http://127.0.0.1:8000/*", "http://192.168.1.16:8000/*"]
}
