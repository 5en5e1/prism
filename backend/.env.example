# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_TIMEOUT_S=600
# Reasoning effort for gpt-5*/o-series: none|low|medium|high|xhigh
# (gpt-5.5 has no "minimal"). Higher = more reasoning tokens / slower.
OPENAI_REASONING_EFFORT=medium
# Shared reasoning+output budget. Must be large for full-page HTML output,
# especially on reasoning models (gpt-5*, o1/o3/o4).
OPENAI_MAX_COMPLETION_TOKENS=32000

# Input Limits
MAX_INPUT_HTML_BYTES=5242880
MAX_TOKENS_PER_REQUEST=100000

# Caching
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=["chrome-extension://*"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_PER_MINUTE_PER_IP=60

# Feature Flags
FEATURE_FLAG_DOM_MANIPULATION=true
FEATURE_FLAG_QA=false
FEATURE_FLAG_REDESIGN=false